COLONIST_JWT=
COLONIST_USERNAME=

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=colonist_tracker

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Signing key for user session bearer tokens (server/services/auth.py). Any
# long random string; rotating it invalidates all existing sessions.
SECRET_KEY=

# The email that self-approves as admin on signup instead of needing an
# existing admin to approve it (server/services/user_auth.py) -- solves the
# bootstrapping problem for the first account.
ADMIN_EMAIL=
